{
  "$schema": "https://opencode.ai/config.json",
  "model": "minimax/MiniMax-M2.1",
  "small_model": "minimax/MiniMax-M2.1",
  "default_agent": "bmad-master",
  // BMAD Framework Configuration
  "instructions": [
    ".opencode/instructions/bmad-constitution.md",
    ".opencode/instructions/governance-rules.md",
    ".opencode/instructions/agent-behavior.md"
  ],
  // BMAD Agent Configuration (Official OpenCode Format)
  "agent": {
    // === PRIMARY AGENTS ===
    "bmad-master": {
      "description": "BMAD Master Orchestrator - Autonomous Mode",
      "mode": "primary",
      "model": "minimax/MiniMax-M2.1",
      "temperature": 0.3,
      "prompt": "{file:agent/bmad-master.md}",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      },
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "task": "allow"
      }
    },
    "ext-master": {
      "description": "BMAD Extension Master Orchestrator - Entry point for all _bmad-ext modules",
      "mode": "primary",
      "model": "minimax/MiniMax-M2.1",
      "temperature": 0.2,
      "prompt": "{file:agent/ext-master.md}",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      },
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "task": "allow"
      }
    },
    "ext-master-enhanced": {
      "description": "Event-Driven Workflow Orchestrator - Sub-agent delegation, event bus",
      "mode": "primary",
      "model": "minimax/MiniMax-M2.1",
      "temperature": 0.2,
      "prompt": "{file:agent/ext-master-enhanced.md}",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      },
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "task": "allow"
      }
    },
    // === SUBAGENTS (Enhanced Agents) ===
    "dev-ext": {
      "description": "Senior Software Engineer - executes delegated development tasks",
      "mode": "subagent",
      "model": "minimax/MiniMax-M2.1",
      "temperature": 0.2,
      "prompt": "{file:agent/dev-ext.md}",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      },
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    },
    "architect-ext": {
      "description": "Software Architect & System Designer - Clean Architecture, DDD, ADRs",
      "mode": "subagent",
      "model": "minimax/MiniMax-M2.1",
      "temperature": 0.1,
      "prompt": "{file:agent/architect-ext.md}",
      "tools": {
        "write": true,
        "edit": true,
        "bash": false
      },
      "permission": {
        "edit": "allow",
        "bash": "ask"
      }
    },
    "ux-designer-ext": {
      "description": "UX/UI Designer - 8-bit aesthetic, accessibility (WCAG), wireframing",
      "mode": "subagent",
      "model": "minimax/MiniMax-M2.1",
      "temperature": 0.3,
      "prompt": "{file:agent/ux-designer-ext.md}",
      "tools": {
        "write": true,
        "edit": true,
        "bash": false
      },
      "permission": {
        "edit": "allow",
        "bash": "ask"
      }
    },
    "tech-writer-ext": {
      "description": "Technical Writer - API docs, user guides, architecture documentation",
      "mode": "subagent",
      "model": "minimax/MiniMax-M2.1",
      "temperature": 0.2,
      "prompt": "{file:agent/tech-writer-ext.md}",
      "tools": {
        "write": true,
        "edit": true,
        "bash": false
      },
      "permission": {
        "edit": "allow",
        "bash": "deny"
      }
    },
    "analyst-ext": {
      "description": "Business Analyst - Requirements gathering, user story breakdown, competitive analysis",
      "mode": "subagent",
      "model": "minimax/MiniMax-M2.1",
      "temperature": 0.2,
      "prompt": "{file:agent/analyst-ext.md}",
      "tools": {
        "write": true,
        "edit": true,
        "bash": false
      },
      "permission": {
        "edit": "allow",
        "bash": "deny"
      }
    },
    "tea-ext": {
      "description": "Test Engineer & QA Specialist - Test strategy, automation (Vitest, Playwright), TDD",
      "mode": "subagent",
      "model": "minimax/MiniMax-M2.1",
      "temperature": 0.1,
      "prompt": "{file:agent/tea-ext.md}",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      },
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    },
    "module-builder-ext": {
      "description": "Enhanced Module Builder - LOOP_STATE integration, ARTIFACT_REGISTRY registration",
      "mode": "subagent",
      "model": "minimax/MiniMax-M2.1",
      "temperature": 0.2,
      "prompt": "{file:agent/module-builder-ext.md}",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      },
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "task": "allow"
      }
    },
    "product-management-ext": {
      "description": "Product Management & Scrum Master - Backlog, stories, sprints, stakeholders",
      "mode": "subagent",
      "model": "minimax/MiniMax-M2.1",
      "temperature": 0.2,
      "prompt": "{file:agent/product-management-ext.md}",
      "tools": {
        "write": true,
        "edit": true,
        "bash": false
      },
      "permission": {
        "edit": "allow",
        "bash": "ask"
      }
    },
    "deep-scan-orchestrator": {
      "description": "Deep Scan Orchestrator - Coordinates diagnostic scanners across domains",
      "mode": "subagent",
      "model": "minimax/MiniMax-M2.1",
      "temperature": 0.1,
      "prompt": "{file:agent/deep-scan-orchestrator.md}",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      },
      "permission": {
        "edit": "ask",
        "bash": "ask"
      }
    }
  },
  // Custom commands for BMAD workflows
  "command": {
    "bmad-sprint": {
      "description": "Execute BMAD sprint workflow with governance enforcement",
      "template": "Execute the following sprint task using BMAD methodology:\n\n$ARGUMENTS\n\nFollow the workflow:\n1. Load context from _bmad/modules/*\n2. Validate task against AGENTS.md\n3. Execute with autonomous decision-making\n4. Update AGENT-STATE.yaml on completion\n5. Enforce governance rules throughout",
      "agent": "bmad-master",
      "model": "minimax/MiniMax-M2.1"
    },
    "bmad-governance": {
      "description": "Run governance validation and enforcement",
      "template": "Run governance validation:\n\n1. Check AGENTS.md for current policies\n2. Validate against context-filter.yaml\n3. Enforce time-boxing rules\n4. Update governance documents if needed\n5. Report violations",
      "agent": "ext-master",
      "model": "minimax/MiniMax-M2.1"
    },
    "bmad-refactor": {
      "description": "Execute architecture remediation workflows",
      "template": "Execute architecture refactoring:\n\n$ARGUMENTS\n\nAvailable workflows:\n- eliminate-god-stores: Split oversized stores into slices\n- normalize-components: Split oversized components\n- workspace-file-system-e2e: Implement workspace E2E\n- knowledge-sync-strategy: Implement knowledge sync\n- notes-sync-strategy: Implement notes sync\n\nLoad context from _bmad-ext/modules/architecture-remediation/",
      "agent": "architect-ext",
      "model": "minimax/MiniMax-M2.1"
    },
    "bmad-scan": {
      "description": "Run deep scan diagnostics",
      "template": "Execute comprehensive code scan:\n\n$ARGUMENTS\n\nAvailable scanners:\n- full-scan: Complete codebase analysis\n- targeted-scan: Focused on specific areas\n- architecture-scan: Layer violations and god components\n- state-scan: Store analysis and circular dependencies\n- types-scan: TypeScript errors and type safety\n- security-scan: Vulnerability detection\n- performance-scan: Performance bottlenecks\n- ux-scan: Accessibility and UX issues\n\nLoad context from _bmad/modules/quality/",
      "agent": "deep-scan-orchestrator",
      "model": "minimax/MiniMax-M2.1"
    },
    "story-cycle": {
      "description": "Execute complete story development cycle v2.0",
      "template": "Execute story development cycle:\n\n$ARGUMENTS\n\n9-Step Workflow:\n1. Create Story - Create story file from epic\n2. Validate Story - Validate story file 100%\n3. Create Context - Build context XML\n4. Validate Context - Validate with freshness check\n5. Pre-Planning - **NEW v2.0** Research gate\n6. Dev Story - TDD implementation\n7. Code Review - Multi-agent review\n8. Story Done - Complete story\n9. Retrospective - Epic-level review\n\nLoad context from _bmad-ext/modules/sprint-planning/\n\nExamples:\n- story-cycle (start new story)\n- story-cycle continue S-001 (continue existing)\n- dev-story story=S-001 (jump to implementation)\n- code-review story=S-001 (run code review)",
      "agent": "dev-ext",
      "model": "minimax/MiniMax-M2.1"
    },
    "create-story": {
      "description": "Create a new story from epic backlog",
      "template": "Create story file:\n\n$ARGUMENTS\n\nRequired: epic={N}\nOptional: story={N} (auto-increment)\n\nLoads: _bmad-ext/modules/sprint-planning/\nOutput: _bmad-output/sprint-artifacts/{epic}-{story}-{slug}.md",
      "agent": "product-management-ext",
      "model": "minimax/MiniMax-M2.1"
    },
    "dev-story": {
      "description": "Implement story with TDD methodology",
      "template": "Implement story with TDD:\n\n$ARGUMENTS\n\nRequired: story={story_key}\n\nWorkflow:\n1. Load context XML\n2. For each task: Red-Green-Refactor\n3. Run full test suite\n4. Update Dev Agent Record\n\nLoads: _bmad-ext/modules/sprint-planning/",
      "agent": "dev-ext",
      "model": "minimax/MiniMax-M2.1"
    },
    "code-review": {
      "description": "Run code review on completed implementation",
      "template": "Execute code review:\n\n$ARGUMENTS\n\nRequired: story={story_key}\nOptional: focus={area}\n\nChecklist:\n- Design compliance (4-layer architecture)\n- Code quality (TypeScript, no any)\n- UI/UX (8-bit design, no glassmorphism)\n- Testing (≥80% coverage)\n- Documentation\n\nLoads: _bmad-ext/modules/governance/",
      "agent": "dev-ext",
      "model": "minimax/MiniMax-M2.1"
    },
    "correct-course": {
      "description": "Recovery workflow for stuck stories",
      "template": "Execute course correction:\n\n$ARGUMENTS\n\nRequired: story={story_key}\n\nTriggered when:\n- Story exceeds 2x timebox\n- Validation loop >3 attempts\n- Unresolvable blockers\n\nOptions:\n- Split story into smaller pieces\n- Defer to next sprint\n- Escalate to architect\n- Reduce scope\n- Continue with acknowledged risk\n\nLoads: _bmad-ext/modules/sprint-planning/",
      "agent": "product-management-ext",
      "model": "minimax/MiniMax-M2.1"
    }
  },
  // Tool permissions for BMAD workflows
  "tools": {
    "write": true,
    "edit": true,
    "bash": true,
    "glob": true,
    "grep": true,
    "read": true
  },
  // Permission controls
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow"
  },
  // Context compaction settings
  "compaction": {
    "auto": true,
    "prune": true
  },
  // File watcher ignore patterns
  "watcher": {
    "ignore": [
      "node_modules/**",
      ".git/**",
      "dist/**",
      "build/**",
      "_bmad-output/**",
      ".DS_Store"
    ]
  },
  // TUI settings
  "tui": {
    "scroll_speed": 2,
    "diff_style": "stacked"
  },
  // Server settings
  "server": {
    "port": 4096,
    "hostname": "0.0.0.0",
    "cors": [
      "http://localhost:5173"
    ]
  }
}