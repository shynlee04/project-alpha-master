{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "bmad-master",
  "instructions": [
    ".opencode/instructions/bmad-constitution.md",
    ".opencode/instructions/governance-rules.md",
    ".opencode/instructions/agent-behavior.md"
  ],
  // === PRIMARY AGENTS ===
  // BMAD Agent Configuration (Official OpenCode Format),
  "agent": { // === DISABLED DEFAULT AGENTS (hidden with no tools) ===
    "bmad-master": {
      "description": "BMAD Master Orchestrator - Entry point for all _bmad-ext modules with full handoff protocol",
      "mode": "primary",
      "temperature": 0.3,
      "prompt": "{file:agent/bmad-master.md}",
      "maxSteps": 2000,
      "tools": {
        "write": false,
        "edit": false,
        "bash": true,
        "glob": true,
        "grep": true,
        "read": true,
        "task": true
      },
      "permission": {
        "edit": "ask",
        "bash": "allow",
        "task": {
          "*": "allow"
        }
      }
    },
    "build": {
      "description": "DISABLED - Use bmad-master",
      "mode": "all",
      "hidden": true,
      "tools": {
        "write": false,
        "edit": false,
        "bash": false,
        "glob": false,
        "grep": false,
        "read": false,
        "task": false
      }
    },
    "plan": {
      "description": "DISABLED - Use bmad-master",
      "mode": "all",
      "hidden": true,
      "tools": {
        "write": false,
        "edit": false,
        "bash": false,
        "glob": false,
        "grep": false,
        "read": false,
        "task": false
      }
    },
    "general": {
      "description": "DISABLED - Use bmad-master",
      "mode": "all",
      "hidden": true,
      "tools": {
        "write": false,
        "edit": false,
        "bash": false,
        "glob": false,
        "grep": false,
        "read": false,
        "task": false
      }
    },
    "explore": {
      "description": "DISABLED - Use bmad-master",
      "mode": "all",
      "hidden": true,
      "tools": {
        "write": false,
        "edit": false,
        "bash": false,
        "glob": false,
        "grep": false,
        "read": false,
        "task": false
      }
    },
    // === EXTENSION AGENTS (can be primary or subagent) ===
    "dev-ext": {
      "description": "Senior Software Engineer - executes delegated development tasks with full handoff protocol",
      "mode": "subagent",
      "temperature": 0.2,
      "prompt": "{file:agent/dev-ext.md}",
      "maxSteps": 50,
      "tools": {
        "write": true,
        "edit": true,
        "bash": true,
        "glob": true,
        "grep": true,
        "read": true
      },
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "task": {
          "*": "allow",
          "tea-ext": "allow"
        }
      }
    },
