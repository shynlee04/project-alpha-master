        "TRAP_6_File_Tree_Anarchy": {
            "skills": [
                "brownfield-guard",
                "global-conventions"
            ],
            "defense": "ADR-039 canonical paths only"
        },
        "TRAP_7_God_Component_Syndrome": {
            "skills": [
                "component-splitter",
                "size-monitor"
            ],
            "defense": "Max 300 LOC per file"
        },
        "TRAP_8_TypeScript_Only_Validation": {
            "skills": [
                "verification-before-completion",
                "e2e-journey"
            ],
            "defense": "E2E evidence required before done"
        },
        "TRAP_9_Nonsense_Sprint_Cohesion": {
            "skills": [
                "cohesion-scanner",
                "dependency-scanner"
            ],
            "defense": "Scan sprint cohesion > 0.7"
        },
        "TRAP_10_Documentation_Drift": {
            "skills": [
                "tech-writer",
                "bi-directional-sync"
            ],
            "defense": "Sync docs with implementation"
        }
    },
