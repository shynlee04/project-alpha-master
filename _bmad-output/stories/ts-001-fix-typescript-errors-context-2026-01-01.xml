        Selected /vitest-dev/vitest (Benchmark Score: 90.4, High Reputation)
        Vitest v4.0.7 available with 2,776 code snippets
      </finding>
    </toolTurn>

    <toolTurn id="3">
      <tool>Web Search (MiniMax)</tool>
      <query>TypeScript error resolution best practices 2026 vitest global imports</query>
      <finding>
        Key insight: Vitest globals require specific TypeScript configuration
        - Add "types": ["vitest/globals"] to tsconfig.json
        - Common error: Cannot find type definition file for 'vitest/globals'
        - Solution: Ensure globals: true in vitest.config.ts
      </finding>
    </toolTurn>

    <toolTurn id="4">
      <tool>Context7 - Get Library Docs</tool>
      <library>/websites/typescriptlang</library>
      <topic>error handling common issues fixes</topic>
      <mode>code</mode>
      <findings>
        <finding id="F-001">
          <title>Missing Return Expressions</title>
          <solution>Arrow functions with curly braces must have explicit return</solution>
          <code>let f2 = () => { return 42; };</code>
        </finding>
        <finding id="F-002">
          <title>Property Access on Undefined</title>
          <solution>TypeScript catches typos during static analysis</solution>
        </finding>
        <finding id="F-003">
          <title>Null Type Checking</title>
          <solution>Use type guards: typeof strs === "object" still possibly null</solution>
        </finding>
        <finding id="F-004">
          <title>Promise Error Handling</title>
          <solution>Always use await with Promises, TypeScript detects missing .then()</solution>
        </finding>
      </findings>
    </toolTurn>

    <toolTurn id="5">
      <tool>Context7 - Get Library Docs</tool>
      <library>/vitest-dev/vitest</library>
      <topic>global imports typescript configuration</topic>
      <mode>code</mode>
      <findings>
        <finding id="V-001">
          <title>Configure TypeScript types for Vitest globals</title>
          <solution>
            Add to tsconfig.json:
            {
              "compilerOptions": {
                "types": ["vitest/globals"]
              }
            }
          </solution>
          <code>{"compilerOptions": {"types": ["vitest/globals"]}}</code>
        </finding>
        <finding id="V-002">
          <title>Custom typeRoots configuration</title>
          <solution>
            Include node_modules in typeRoots array:
            {
              "compilerOptions": {
                "typeRoots": ["./types", "./node_modules/@types", "./node_modules"],
                "types": ["vitest/globals"]
              }
            }
          </solution>
        </finding>
        <finding id="V-003">
          <title>Enable globals in Vitest config</title>
          <solution>
            Set globals: true in vitest.config.ts:
            export default defineConfig({
              test: { globals: true }
            });
          </solution>
        </finding>
        <finding id="V-004">
          <title>Configure TypeScript for jsdom Environment</title>
          <solution>
            Add to tsconfig.json:
            {
              "compilerOptions": {
                "types": ["vitest/jsdom"]
              }
            }
          </solution>
        </finding>
      </findings>
    </toolTurn>
  </researchFindings>

