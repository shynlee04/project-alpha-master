  <user_story>
    <actor>WebContainer User</actor>
    <action>want file changes made inside the WebContainer</action>
    <benefit>sync back to local file system to work with complete project state locally</benefit>
  </user_story>

  <acceptance_criteria>
    <criterion id="AC-1">Create ReverseSyncService class in src/lib/sync/</criterion>
    <criterion id="AC-2">Implement file watcher to detect WebContainer changes</criterion>
    <criterion id="AC-3">Add reverse sync logic to copy changed files back to local FS</criterion>
    <criterion id="AC-4">Integrate with SyncEventBus for event listening</criterion>
    <criterion id="AC-5">Add conflict resolution strategy</criterion>
    <criterion id="AC-6">Implement exclusion patterns for reverse sync</criterion>
    <criterion id="AC-7">Write unit tests for reverse sync functionality</criterion>
  </acceptance_criteria>

  <constraints>
    <constraint type="sync_direction">WebContainer → Local FS only (one-way)</constraint>
    <constraint type="performance">Debounced batch operations to avoid excessive FS writes</constraint>
    <constraint type="conflict_resolution">Prefer local changes (safer default)</constraint>
    <constraint type="exclusions">.git, node_modules, .DS_Store, Thumbs.db</constraint>
    <constraint type="permissions">Handle FileSystemAccessAPI permission errors gracefully</constraint>
  </constraints>

  <research_references>
    <reference type="context7" tool="WebContainer API Documentation" url="/websites/webcontainers_io_guides">
      <details>fs.readFile, fs.writeFile methods for file operations</details>
    </reference>
    <reference type="deepwiki" tool="WebContainer Core" repo="stackblitz/webcontainer-core">
      <details>File system API patterns</details>
    </reference>
    <reference type="codebase" tool="Existing Sync Infrastructure">
      <file path="src/lib/sync/sync-event-bus.ts">SyncEventBus implementation</file>
      <file path="src/lib/sync/event-types.ts">Event type definitions</file>
      <file path="src/lib/filesystem/local-fs-adapter.ts">LocalFSAdapter for writing files</file>
      <file path="src/lib/webcontainer/manager.ts">WebContainer manager singleton</file>
      <file path="src/lib/filesystem/sync-types.ts">SyncError types</file>
    </reference>
  </research_references>

  <architecture>
    <flow>
      <step name="1">WebContainer FS changes occur</step>
      <step name="2">SyncEventBus emits file events (file:created, file:modified, file:deleted)</step>
      <step name="3">ReverseSyncService listens to events</step>
      <step name="4">Service reads file from WebContainer</step>
      <step name="5">Service writes file to Local FS via LocalFSAdapter</step>
    </flow>
  </architecture>

  <implementation_details>
    <class name="ReverseSyncService">
      <properties>
        <property name="syncEventBus">SyncEventBus instance</property>
        <property name="localFSAdapter">LocalFSAdapter instance</property>
        <property name="exclusionPatterns">string[] - patterns to exclude</property>
        <property name="isRunning">boolean - service running state</property>
        <property name="conflictResolution">'local' | 'remote' | 'merge'</property>
        <property name="debounceTimers">Map<string, NodeJS.Timeout></property>
      </properties>
      <methods>
        <method name="start()">Subscribe to SyncEventBus events</method>
        <method name="stop()">Unsubscribe and cleanup</method>
        <method name="syncFile(wcPath)">Read from WC, write to local FS</method>
        <method name="isExcluded(path)">Check if path matches exclusion patterns</method>
        <method name="handleFileChange(path)">Debounced file change handler</method>
      </methods>
    </class>
  </implementation_details>

  <exclusion_patterns>
    <pattern>.git</pattern>
    <pattern>node_modules</pattern>
    <pattern>.DS_Store</pattern>
    <pattern>Thumbs.db</pattern>
    <pattern>*.swp</pattern>
    <pattern>*.swo</pattern>
  </exclusion_patterns>

