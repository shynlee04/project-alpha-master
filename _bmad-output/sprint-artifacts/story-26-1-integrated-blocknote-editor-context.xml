// Epic 26: Notes table (version 11)
export interface NoteRecord {
  id: string;              // Primary key (UUID)
  projectId: string;       // Foreign key to project
  title: string;           // Note title (extracted from first heading)
  emoji?: string;          // Optional icon emoji
  blocks: unknown[];       // BlockNote JSON structure
  parentId?: string;       // For nesting (null = root)
  isFavorite: boolean;     // Starred notes
  order: number;           // Sort order within parent
  createdAt: number;
  updatedAt: number;
}
      ]]></snippet>
