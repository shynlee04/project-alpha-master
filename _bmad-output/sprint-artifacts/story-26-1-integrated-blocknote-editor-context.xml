  <research_notes>
    <finding source="context7" query="BlockNote save load persistence" validated="true">
      <pattern>Use editor.document to get JSON blocks array</pattern>
      <pattern>Use initialContent prop to restore content</pattern>
      <code><![CDATA[
import { useCreateBlockNote } from "@blocknote/react";
import { BlockNoteView } from "@blocknote/mantine";
import "@blocknote/mantine/style.css";

export function NoteEditor({ initialContent, onSave }) {
  const editor = useCreateBlockNote({ initialContent });
  return (
    <BlockNoteView 
      editor={editor} 
      onChange={() => onSave(editor.document)} 
    />
  );
}
      ]]></code>
    </finding>
    
