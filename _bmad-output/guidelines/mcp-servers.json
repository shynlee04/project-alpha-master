{
    "mcpServers": {
        "context7": {
            "command": "npx",
            "args": [
                "-y",
                "@upstash/context7-mcp@latest"
            ],
            "alwaysAllow": [
                "get-library-docs",
                "resolve-library-id",
                "query-docs"
            ],
            "timeout": 300
        },
        "playwright": {
            "command": "npx",
            "args": [
                "@playwright/mcp@latest"
            ],
            "disabled": true,
            "alwaysAllow": [
                "browser_take_screenshot",
                "browser_navigate"
            ]
        },
        "memory": {
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-memory"
            ],
            "env": {
                "MEMORY_FILE_PATH": ""
            },
            "disabled": false,
            "alwaysAllow": [
                "create_entities",
                "create_relations",
                "add_observations",
                "delete_entities",
                "delete_observations",
                "delete_relations",
                "read_graph",
                "search_nodes",
                "open_nodes"
            ],
            "timeout": 300
        },
        "deepwiki": {
            "command": "npx",
            "args": [
                "-y",
                "mcp-remote",
                "https://mcp.deepwiki.com/sse"
            ],
            "env": {},
            "alwaysAllow": [
                "ask_question",
                "read_wiki_contents",
                "deepwiki-query",
                "read_wiki_structure"
            ],
            "timeout": 900
        },
        "sequentialthinking": {
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-sequential-thinking"
            ],
            "alwaysAllow": [
                "sequentialthinking"
            ],
            "disabled": false,
            "timeout": 300
        },
        "tavily": {
            "command": "npx",
            "args": [
                "-y",
                "tavily-mcp@0.2.3"
            ],
            "env": {
                "TAVILY_API_KEY": "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"
            },
            "alwaysAllow": [
                "tavily-search",
                "tavily-crawl",
                "tavily-extract",
                "tavily-map"
            ],
            "timeout": 300
        },
        "exa": {
            "command": "npx",
            "args": [
                "-y",
                "exa-mcp-server"
            ],
            "env": {
                "EXA_API_KEY": "0f87e4ce-23ed-4bb1-85b2-2bf04ae7caba"
            },
            "alwaysAllow": [
                "web_search_exa",
                "get_code_context_exa"
            ],
            "timeout": 300
        },
        "filesystem": {
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-filesystem",
                "/Users/apple/Documents/"
            ],
            "alwaysAllow": [
                "read_file",
                "read_text_file",
                "read_media_file",
                "read_multiple_files",
                "write_file",
                "edit_file",
                "create_directory",
                "list_directory",
                "list_directory_with_sizes",
                "directory_tree",
                "move_file",
                "search_files",
                "get_file_info",
                "list_allowed_directories"
            ],
            "timeout": 600
        },
        "repomix": {
            "command": "npx",
            "args": [
                "-y",
                "repomix",
                "--mcp"
            ],
            "alwaysAllow": [
                "pack_codebase",
                "pack_remote_repository",
                "read_repomix_output",
                "grep_repomix_output",
                "file_system_read_file",
                "file_system_read_directory"
            ],
            "timeout": 600
        },
        "brave-search": {
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-brave-search"
            ],
            "env": {
                "BRAVE_API_KEY": "BSAoe1zO-z-9yeDLJ__8L4n11Y8EL7V"
            },
            "alwaysAllow": [
                "brave_web_search"
            ]
        },
        "MiniMax": {
            "command": "uvx",
            "args": [
                "minimax-coding-plan-mcp",
                "-y"
            ],
            "env": {
                "MINIMAX_API_KEY": "sk-cp-xDMzbctSaJp9k7sXuav9yisXufMuQBNfbT4Z9IWrpmZ0ERszh42NFQPpFkEFaXEhuYa5mNTnyxWS0RDH-XN4ZIbEBN6wFkq0s1wWyfRQUT5Jo-jFXZjqw4o",
                "MINIMAX_API_HOST": "https://api.minimax.io"
            },
            "alwaysAllow": [
                "web_search",
                "understand_image"
            ],
            "timeout": 300
        },
        "time": {
            "command": "uvx",
            "args": [
                "mcp-server-time"
            ]
        }
    }
}
