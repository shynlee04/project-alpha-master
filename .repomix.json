{
  "output": "project-alpha-packfile.txt",
  "outputStyle": "markdown",
  "include": [
    "src/**/*",
    "public/**/*",
    "routes/**/*",
    "*.config.*",
    "*.json",
    "*.md",
    ".env.example",
    "i18next-scanner.config.cjs",
    "vite.config.ts",
    "tsconfig.json",
    "tsconfig.node.json",
    "vitest.config.ts",
    "package.json",
    ".gitignore",
    "CLAUDE.md",
    "AGENTS.md",
    ".cursor/**/*",
    ".claude/**/*",
    ".agent/**/*"
  ],
  "exclude": [
    "node_modules/**/*",
    "dist/**/*",
    "dist-ssr/**/*",
    ".output/**/*",
    ".vinxi/**/*",
    ".wrangler/**/*",
    ".git/**/*",
    ".DS_Store",
    "Thumbs.db",
    "*.log",
    "*.local",
    ".env",
    ".nitro",
    ".tanstack",
    "coverage/**/*",
    "build/**/*",
    "_bmad-output/**/*",
    ".android-docs/**/*",
    ".augment/**/*",
    ".clinerules/**/*",
    ".codex/**/*",
    ".crush/**/*",
    ".gemini/**/*",
    ".iflow/**/*",
    ".kilocode/**/*",
    "todos.json",
    ".nitro/**/*",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/__tests__/**/*",
    "src/i18n/en/**/*",
    "src/i18n/vi/**/*",
    "src/data/**/*"
  ],
  "topFiles": [
    "README.md",
    "CLAUDE.md",
    "AGENTS.md",
    "package.json",
    "vite.config.ts",
    "tsconfig.json"
  ],
  "compress": true,
  "removeComments": false,
  "removeEmptyLines": false,
  "fileSummary": true,
  "directoryStructure": true
}
