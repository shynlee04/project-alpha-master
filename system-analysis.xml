import { useAgentsStore, DEFAULT_AGENT } from './agents-store';

// Mock Dexie Storage to behave synchronously/in-memory for tests
vi.mock('@/lib/state/dexie-storage', () => ({
    createDexieStorage: () => ({
        getItem: vi.fn(),
