          }
          50% {
            transform: translateY(8px);
            opacity: 0.5;
          }
        }

        .scroll-indicator {
          animation: scroll-bounce 2s var(--animation-easing-8bit) infinite;
        }

        @media (prefers-reduced-motion: reduce) {
          .scroll-indicator {
            animation: none !important;
          }
          
          .hero-content > *,
          img {
            animation: none !important;
            opacity: 1 !important;
          }
        }
      `}</style>
    </section>
  );
}
