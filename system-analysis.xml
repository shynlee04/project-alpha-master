                timestamp: expect.any(Date),
                filesProcessed: expect.any(Number),
            });

            expect(webcontainer.mount).toHaveBeenCalledWith({
                folder: {
                    directory: {
                        'file.txt': { file: { contents: 'data' } }
                    }
                }
