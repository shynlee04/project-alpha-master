/**
 * @fileoverview Agent Memory Module Barrel Export
 * @module lib/agent/memory
 * @governance EPIC-31-1
 *
 * Conversation memory with IndexedDB storage and semantic search.
 */

export {
  storeConversation,
  searchConversations,
  getRecentConversations,
  pruneOldConversations,
  updateAccessTime,
  setExcluded,
