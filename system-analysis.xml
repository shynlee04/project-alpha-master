            role: 'Test',
            status: 'online',
            provider: 'OpenRouter',
            model: 'test',
            description: 'Test',
        });

        // Reset
        useAgentsStore.getState().resetToDefaults();

        const { agents, activeAgentId } = useAgentsStore.getState();
        expect(agents.length).toBe(1);
        expect(agents[0].id).toBe(DEFAULT_AGENT.id);
        expect(activeAgentId).toBe(DEFAULT_AGENT.id);
    });
});
