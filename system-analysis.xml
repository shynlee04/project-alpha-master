        @media (min-width: 1440px) {
          .hero-section {
            padding: var(--spacing-lg) * 8 var(--spacing-lg) * 4 !important;
            max-width: 1280px !important;
          }
        }

        @keyframes fade-in-up {
          from {
            opacity: 0;
            transform: translateY(20px);
          }
          to {
            opacity: 1;
            transform: translateY(0);
          }
        }

        @keyframes scroll-bounce {
          0%, 100% {
            transform: translateY(0);
