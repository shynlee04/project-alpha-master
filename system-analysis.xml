    describe('addSourceToCollection (Story 6-3)', () => {
        it('should add source to collection', async () => {
            const mockCollections = [
                {
                    id: 'collection-1',
                    projectId: 'project-1',
                    name: 'Test Collection',
                    sourceIds: ['source-2'],
