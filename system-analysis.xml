        }));

        expect(result.current.providerId).toBe('openai');
        expect(result.current.modelId).toBe('gpt-4o');
    });

    it('should build description for write_file tool', () => {
        vi.mocked(useChat).mockReturnValue({
            messages: [
                {
                    role: 'assistant',
                    parts: [
                        {
                            type: 'tool-call',
                            id: 'tc-1',
                            name: 'write_file',
                            state: 'approval-requested',
