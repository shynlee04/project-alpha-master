{
  "permissions": {
    "allow": [
      "Bash(where npx)",
      "Bash(dir:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm tsc --noEmit)",
      "Bash(pnpm tsc:*)",
      "Bash(pnpm test:*)",
      "Bash(cat:*)",
      "Bash(pnpm vitest:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(wc:*)",
      "Bash(chmod:*)",
      "Bash(find:*)",
      "Bash(bash .claude/hooks/*)"
    ]
  },
  "outputStyle": "critical-code-reviewer",
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/context-bridge.sh"
          }
        ]
      }
    ]
  }
}
